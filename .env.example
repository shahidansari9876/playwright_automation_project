# ─────────────────────────────────────────────────────────────
#  STQ Playwright Email Reporter — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here    # For Gmail: use an App Password, not your login password

# Sender display name + address
EMAIL_FROM="STQ Automation <your_email@gmail.com>"

# Recipient — who should receive the test result email
EMAIL_TO=recipient@example.com

# Optional: comma-separated CC list
EMAIL_CC=

# Playwright HTML Report Server URL (where the report is hosted/served)
REPORT_URL=http://localhost:9323/

